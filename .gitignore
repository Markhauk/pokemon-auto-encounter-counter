# Python cache and build artifacts
__pycache__/
*.py[cod]
*.pyd
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
.env
.env.*

# Tooling and local caches
.tmp/
.uv-cache/

# IDE and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Runtime output and local state
output/
*.log

# Local config and machine-specific settings
config.json

